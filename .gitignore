# Local Steam Workshop fetch artifacts (downloaded workshop content).
# These are pulled on-demand by scripts/abitoads.py and never committed.
/.steam/

# Clean collection of videos named by their manifest names (just fetch).
/.wallpapers/

# Self-hosted GitHub Actions runner install (just runner).
/.runner/

# Python bytecode cache
__pycache__/
*.pyc

# devenv
/.devenv/
/.devenv.flake.nix
/devenv.local.nix
/.direnv/
